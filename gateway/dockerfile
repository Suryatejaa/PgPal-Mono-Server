FROM node:20-alpine

WORKDIR /app

# Install curl for health checks and PM2 for process management
RUN apk add --no-cache curl
RUN npm install -g pm2

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production && npm cache clean --force

# Copy source code
COPY . .

# Set permissions BEFORE creating user (this is the fix)
RUN chmod +x start.sh

# Create non-root user and set ownership AFTER setting permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

# Switch to non-root user LAST
USER nodejs

# Health check for both services
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:4000/api/gateway/health && curl -f http://localhost:4011/health || exit 1

EXPOSE 4000 4011

# Start both gateway and websocket services
CMD ["./start.sh"]