# Room Service Environment Configuration
# Copy this file to .env and configure your settings

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pgpaal_rooms
REDIS_URL=redis://default:olSyNYOqffHjLRrsMWcnBVqQrRNOkCdL@nozomi.proxy.rlwy.net:33219

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ADMIN_SESSION_TIMEOUT=3600000
BCRYPT_ROUNDS=12

# Admin System Configuration
ADMIN_RATE_LIMIT_WINDOW=900000
ADMIN_RATE_LIMIT_MAX=100
ADMIN_CACHE_TTL=300
ADMIN_LOG_RETENTION_DAYS=90

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@pgpaal.com
EMAIL_FROM_NAME=PG Paal Admin System

# Slack Integration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#admin-alerts
SLACK_USERNAME=PG-Paal-Bot

# Webhook Notifications (optional)
WEBHOOK_URL=https://your-webhook-endpoint.com/notifications
WEBHOOK_SECRET=your-webhook-secret

# File Storage Configuration
EXPORT_DIR=./exports
MAX_EXPORT_FILE_SIZE=50000000
EXPORT_CLEANUP_INTERVAL=86400000

# Performance & Monitoring
HEALTH_CHECK_INTERVAL=300000
PERFORMANCE_THRESHOLD_MS=5000
MEMORY_THRESHOLD_MB=512

# Feature Flags
ENABLE_CSV_EXPORT=true
ENABLE_NOTIFICATION_SYSTEM=true
ENABLE_SCHEDULED_REPORTS=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ADMIN_ANALYTICS=true

# Scheduled Reports Configuration
DAILY_REPORT_TIME=09:00
WEEKLY_REPORT_DAY=1
MONTHLY_REPORT_DATE=1
SYSTEM_HEALTH_CHECK_INTERVAL=*/15 * * * *

# Analytics Configuration
ANALYTICS_RETENTION_MONTHS=12
TREND_CALCULATION_PERIODS=7,30,90
FORECAST_PERIODS=30,90

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/admin.log
MAX_LOG_FILE_SIZE=10000000
MAX_LOG_FILES=5

# Rate Limiting Configuration
DASHBOARD_RATE_LIMIT=60
ANALYTICS_RATE_LIMIT=30
BULK_OPERATIONS_RATE_LIMIT=10
EXPORT_RATE_LIMIT=5

# Cache Configuration
DASHBOARD_CACHE_TTL=300
ANALYTICS_CACHE_TTL=600
ROOM_DATA_CACHE_TTL=900
SYSTEM_HEALTH_CACHE_TTL=60

# Development & Debug
DEBUG_ADMIN=false
MOCK_EXTERNAL_APIS=false
ENABLE_QUERY_LOGGING=false
